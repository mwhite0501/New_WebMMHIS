@page "/{RouteId?}/{SectionId?}/{DirectionId?}/{SearchText?}/{YearId?}"

<div class="app @(drawerOpen ? "drawer-open" : null) @(panelCollapsed ? "panel-collapsed" : null)">
    <header class="topbar">
        <button type="button" class="topbar-menu" @onclick="TogglePanelAsync" title="Show or hide the side panel" aria-controls="finder-panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
            <span>Find imagery</span>
        </button>

        <a class="brand" href="">
            <img src="Images/ArDOT_Logo_1.png" alt="ARDOT" width="96" height="36" />
            <span class="brand-name">Arkansas Highway Imagery</span>

        </a>

        @if (loadedRun != null)
        {
            <dl class="topbar-run" aria-label="Current run">
                <div><dt>Route</dt><dd>@loadedRun.Route</dd></div>
                <div><dt>Section</dt><dd>@loadedRun.Section</dd></div>
                <div><dt>Direction</dt><dd>@loadedRun.Direction</dd></div>
                <div><dt>Captured</dt><dd>@loadedRun.Year</dd></div>
            </dl>
        }

        <button type="button" class="btn btn-onDark" id="copy-link" disabled>Copy link</button>
    </header>

    <aside class="panel" id="finder-panel">
        <form class="panel-section finder" @onsubmit="ShowImageryAsync" aria-labelledby="finder-heading">
            <h2 id="finder-heading">Find imagery</h2>

            <label class="field">
                <span class="field-label">Route</span>
                <select value="@route" @onchange="OnRouteChanged" disabled="@(catalog == null)">
                    <option value="" disabled selected="@(route == null)">Choose a route</option>
                    @if (catalog != null)
                    {
                        @foreach (var r in catalog.Routes)
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </label>

            <div class="field-row">
                <label class="field">
                    <span class="field-label">Section</span>
                    <select value="@(section)" @onchange="OnSectionChanged" disabled="@(route == null)">
                        @foreach (var s in sections)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span class="field-label">Direction</span>
                    <select value="@direction" @onchange="OnDirectionChanged" disabled="@(route == null)">
                        @foreach (var d in directions)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </label>
            </div>

            <div class="field-row">
                <label class="field">
                    <span class="field-label">Captured</span>
                    <select value="@year" @onchange="OnYearChanged" disabled="@(route == null)">
                        @foreach (var y in years)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span class="field-label">Start at log mile</span>
                    <input type="text" inputmode="decimal" autocomplete="off" placeholder="@(loadedRun != null ? "Current" : "Beginning")"
                           value="@logmileText" @onchange="e => logmileText = e.Value?.ToString()" disabled="@(route == null)" />
                </label>
            </div>

            <div class="finder-actions">
                <button type="submit" class="btn btn-primary" disabled="@(year == null || busy)">
                    @(busy ? "Loading…" : "Show imagery")
                </button>
                <button type="button" class="btn btn-quiet" @onclick="ResetAsync" disabled="@(route == null && loadedRun == null)">Reset</button>
            </div>

            @if (!string.IsNullOrEmpty(status))
            {
                <p class="status @(statusIsError ? "status-error" : null)" role="status">@status</p>
            }

            <p class="hint">Or double-click the map to open the nearest imagery. Click the green route line to jump along it.</p>
        </form>

        @if (facts != null)
        {
            <section class="panel-section" aria-labelledby="facts-heading">
                <h2 id="facts-heading" class="visually-hidden">Location</h2>
                <dl class="facts">
                    <div><dt>District</dt><dd>@(string.IsNullOrWhiteSpace(facts.District) ? "Not recorded" : facts.District)</dd></div>
                    <div><dt>County</dt><dd>@CountyName(facts.County)</dd></div>
                </dl>
            </section>
        }

        <DisplaySettings />

        <section class="panel-section keys" aria-labelledby="keys-heading">
            <h2 id="keys-heading">Keyboard</h2>
            <dl class="keylist">
                <div><dt><kbd>Space</kbd></dt><dd>Play or pause</dd></div>
                <div><dt><kbd>Shift</kbd> <kbd>Space</kbd></dt><dd>Play backward</dd></div>
                <div><dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Step one frame (hold Shift for 10)</dd></div>
                <div><dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>Jump to start or end</dd></div>
                <div><dt><kbd>1</kbd>–<kbd>6</kbd></dt><dd>Switch camera</dd></div>
                <div><dt><kbd>F</kbd></dt><dd>Full screen</dd></div>
            </dl>
        </section>
    </aside>

    <button type="button" class="scrim" tabindex="-1" aria-hidden="true" @onclick="() => drawerOpen = false"></button>

    <main class="stage">
        <PlayerView />
        <MapView />
    </main>
</div>
