@page
@model NewMMHIS_Web.Pages.ErrorModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error | MMHIS</title>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="error-page">
    <main>
        <h1>The imagery viewer hit an error</h1>
        <p>Reload the page to try again. If it keeps happening, send the request ID below to the Application Services team.</p>
        @if (Model.ShowRequestId)
        {
            <p>Request ID: <code>@Model.RequestId</code></p>
        }
        <p><a href="~/">Back to the viewer</a></p>
    </main>
</body>
</html>
